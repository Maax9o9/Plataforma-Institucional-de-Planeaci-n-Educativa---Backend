APP_NAME="Plataforma Institucional de Planeacion Educativa"
ENVIRONMENT=development
SECRET_KEY="replace-this-development-secret-with-a-long-random-value"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# En produccion debe ser true. SameSite=None tambien exige Secure=true.
REFRESH_COOKIE_NAME=planeacion_refresh
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Servidor de pruebas: permite cualquier origen.
# Produccion: debe ser false y configurar CORS_ORIGINS explicitamente.
CORS_ALLOW_ALL=false

# Crear administrador manualmente: python -m app.scripts.create_admin --help
# Las credenciales administrativas no se guardan en este archivo.

# PostgreSQL usado por SQLAlchemy async y Alembic.
DATABASE_URL=postgresql+asyncpg://planeacion:planeacion_dev@localhost:5433/planeacion
POSTGRES_PASSWORD=planeacion_dev
DATABASE_ECHO=false

# Correo seguro por consola mientras no exista cuenta institucional.
EMAIL_PROVIDER=console
EMAIL_SENDER=notificaciones@upchiapas.edu.mx
SMTP_PORT=587
SMTP_START_TLS=true
# URL del frontend. Se usa en el enlace de establecimiento de contrasena.
# Si no hay frontend, apunta a la IP del backend.
FRONTEND_URL=http://localhost:3000
PASSWORD_SETUP_EXPIRE_HOURS=24
LOGIN_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
UPLOAD_DIRECTORY=var/uploads
UPLOAD_MAX_BYTES=10485760
# Frecuencia del proceso idempotente de recordatorios (minimo 300 segundos).
REMINDER_CHECK_INTERVAL_SECONDS=21600
# Solo se usa al ejecutar manualmente `python -m app.scripts.seed_integration`.
# Define el valor por variable de entorno y no lo confirmes en Git.
SEED_TEST_PASSWORD=
# SMTP_HOST=
# SMTP_USER=
# SMTP_PASSWORD=
